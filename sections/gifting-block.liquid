<section class="section-spacing" id="GiftingBlock-{{ section.id }}" style="padding-top: 0;">
  <div class="page-width">
    <div class="gifting-block">
      <div class="gifting-grid">
        <div class="gifting-media">
          <img src="{{ 'gift-packaging.jpg' | asset_url }}" alt="Iraya Luxury Jewelry Gift Packaging" loading="lazy">
        </div>

        <div class="gifting-content">
          <span class="section-eyebrow">Thoughtfully Packaged</span>
          <h2 class="section-title">Every Piece Arrives Gift-Ready</h2>
          <p class="section-description">
            Whether honoring a milestone, celebrating Diwali, or gifting yourself, every Iraya order arrives in our signature gold-embossed ivory box with a velvet travel pouch and anti-tarnish storage tab.
          </p>

          <div class="gifting-perks">
            <div class="gifting-perk">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Complimentary embossed gift box & velvet travel pouch included</span>
            </div>
            <div class="gifting-perk">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Personalized handwritten gift message option at checkout</span>
            </div>
            <div class="gifting-perk">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>Includes Certificate of 925 Authenticity & Silver Polishing Cloth</span>
            </div>
          </div>

          <div style="display: flex; gap: 14px; flex-wrap: wrap;">
            <a href="/collections/gifts" class="btn btn--primary">Shop Curated Gifts</a>
            <a href="/collections/under-100" class="btn btn--secondary">Gifts Under $100</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gifting Block",
  "settings": [],
  "presets": [
    {
      "name": "Gifting Block"
    }
  ]
}
{% endschema %}
