<section class="section-spacing" id="CustomerReviews-{{ section.id }}">
  <div class="page-width">
    <div class="section-header text-center">
      <span class="section-eyebrow">Worn & Cherished</span>
      <h2 class="section-title">From Jaipur to New York</h2>
      <p class="section-description">See how our US community styles handcrafted Indian silver for everyday elegance.</p>
    </div>

    <div class="reviews-grid">
      <div class="review-card">
        <div class="review-card__stars">★★★★★</div>
        <p class="review-card__text">"The Aahana choker is pure poetry. You can instantly tell it's solid silver by its substantial weight, yet it feels completely weightless around the neck. Arrived in NYC in just 3 business days!"</p>
        <div class="review-card__author">
          <span>Ananya S. — New York, NY</span>
          <span class="review-card__verified">✓ Verified Buyer</span>
        </div>
      </div>

      <div class="review-card">
        <div class="review-card__stars">★★★★★</div>
        <p class="review-card__text">"I have extremely sensitive skin and react to almost all commercial earrings. These filigree drops caused zero irritation even after wearing them for 10 hours at a wedding. The packaging was immaculate."</p>
        <div class="review-card__author">
          <span>Maya P. — San Francisco, CA</span>
          <span class="review-card__verified">✓ Verified Buyer</span>
        </div>
      </div>

      <div class="review-card">
        <div class="review-card__stars">★★★★★</div>
        <p class="review-card__text">"The moonstone ring is a stunner. The jaali cutwork is so refined—it looks like an antique family heirloom passed down generations. Incredible customer service when I needed to exchange sizes."</p>
        <div class="review-card__author">
          <span>Claire D. — Austin, TX</span>
          <span class="review-card__verified">✓ Verified Buyer</span>
        </div>
      </div>
    </div>

    <!-- Editorial Press Mentions -->
    <div class="press-strip">
      <span class="press-logo">VOGUE</span>
      <span class="press-logo">ELLE</span>
      <span class="press-logo">HARPER'S BAZAAR</span>
      <span class="press-logo">ARCHITECTURAL DIGEST</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [],
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}
