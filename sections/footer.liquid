<footer class="site-footer" id="SiteFooter">
  <div class="page-width">
    <div class="footer-grid">
      <!-- Col 1: Brand Story -->
      <div class="footer-col">
        <h3 class="site-logo__text" style="font-size: 26px; color: #FFFFFF; margin-bottom: 8px;">IRAYA</h3>
        <p style="font-size: var(--text-sm); color: var(--color-text-inverse-muted); line-height: 1.6; max-width: 320px;">
          Authentic 925 sterling silver Indian handcrafted jewellery, designed with quiet modern reverence for discerning collectors in the United States.
        </p>
        <div class="footer-origin-badge">
          <span>🇮🇳 Handcrafted in India</span>
          <span>•</span>
          <span>🇺🇸 Dispatched to US</span>
        </div>
      </div>

      <!-- Col 2: Customer Care -->
      <div class="footer-col">
        <h4 class="footer-col__title">Customer Care</h4>
        <ul class="footer-col__list">
          <li><a href="/pages/shipping-returns" class="footer-col__link">US Shipping & Duties</a></li>
          <li><a href="/pages/shipping-returns#returns" class="footer-col__link">30-Day US Returns Portal</a></li>
          <li><a href="/pages/care-guide" class="footer-col__link">Silver Care & Cleaning</a></li>
          <li><a href="/pages/size-guide" class="footer-col__link">Ring & Bracelet Size Guide</a></li>
          <li><a href="/pages/faq" class="footer-col__link">FAQs & Concierge</a></li>
        </ul>
      </div>

      <!-- Col 3: The Ateliers -->
      <div class="footer-col">
        <h4 class="footer-col__title">Our Craft</h4>
        <ul class="footer-col__list">
          <li><a href="/pages/our-craft" class="footer-col__link">Artisan Lineages</a></li>
          <li><a href="/pages/our-craft#filigree" class="footer-col__link">Tarakasi Filigree</a></li>
          <li><a href="/pages/our-craft#hallmarking" class="footer-col__link">925 Hallmark Standards</a></li>
          <li><a href="/blogs/journal" class="footer-col__link">The Iraya Journal</a></li>
          <li><a href="/pages/contact" class="footer-col__link">Contact Atelier</a></li>
        </ul>
      </div>

      <!-- Col 4: Shop Links -->
      <div class="footer-col">
        <h4 class="footer-col__title">Collections</h4>
        <ul class="footer-col__list">
          <li><a href="/collections/earrings" class="footer-col__link">Silver Earrings</a></li>
          <li><a href="/collections/necklaces" class="footer-col__link">Chokers & Necklaces</a></li>
          <li><a href="/collections/rings" class="footer-col__link">Jaali Cutwork Rings</a></li>
          <li><a href="/collections/bracelets" class="footer-col__link">Cuffs & Bangles</a></li>
          <li><a href="/collections/gifts" class="footer-col__link">Curated Gift Sets</a></li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <div class="copyright">
        © {{ 'now' | date: '%Y' }} Iraya Studio LLC. All rights reserved. Prices displayed in USD.
      </div>

      <div class="payment-badges">
        <span class="payment-badge">Shop Pay</span>
        <span class="payment-badge">Apple Pay</span>
        <span class="payment-badge">Google Pay</span>
        <span class="payment-badge">PayPal</span>
        <span class="payment-badge">Visa</span>
        <span class="payment-badge">Mastercard</span>
        <span class="payment-badge">Amex</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
