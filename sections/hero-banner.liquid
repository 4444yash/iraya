<section class="hero-banner" id="HeroBanner-{{ section.id }}">
  <div class="hero-banner__media">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '375, 750, 1100, 1500, 2000',
        sizes: '100vw',
        alt: section.settings.heading | escape,
        class: 'hero-banner__image'
      }}
    {%- else -%}
      <img 
        src="{{ 'hero-editorial.jpg' | asset_url }}" 
        alt="Iraya Indian Silver Jewellery" 
        class="hero-banner__image"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="hero-banner__overlay"></div>
  </div>

  <div class="page-width">
    <div class="hero-banner__content">
      <span class="hero-eyebrow">{{ section.settings.eyebrow | default: "Handcrafted in 925 Sterling Silver" }}</span>
      <h1 class="hero-title">{{ section.settings.heading | default: "Heirloom Indian Silver, Reimagined." }}</h1>
      <p class="hero-subtitle">{{ section.settings.subheading | default: "Centuries-old artisanal filigree and temple craftsmanship meet quiet, modern silhouettes. Designed for everyday luxury in the United States." }}</p>
      
      <div class="hero-actions">
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn--gold">
          {{ section.settings.button_text | default: "Shop the Collection" }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image (High Resolution)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Handcrafted in 925 Sterling Silver"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Heirloom Indian Silver, Reimagined."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheadline",
      "default": "Centuries-old artisanal filigree and temple craftsmanship meet quiet, modern silhouettes. Designed for everyday luxury in the United States."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
