{%- comment -%}
  Renders a luxury product card with image hover swap, craft tags, and ratings
  Accepts:
  - product: {Object} Product Liquid object
  - show_quick_add: {Boolean}
{%- endcomment -%}

<div class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__media">
    <a href="{{ product.url }}" class="product-card__link">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 600 | image_tag:
          loading: 'lazy',
          widths: '300, 450, 600',
          sizes: '(max-width: 600px) 50vw, (max-width: 1024px) 33vw, 25vw',
          alt: product.title | escape,
          class: 'product-card__image-primary'
        }}
      {%- else -%}
        <img src="{{ 'cat-earrings.jpg' | asset_url }}" alt="{{ product.title | escape }}" class="product-card__image-primary" loading="lazy">
      {%- endif -%}

      {%- if product.media[1] -%}
        {{ product.media[1] | image_url: width: 600 | image_tag:
          loading: 'lazy',
          widths: '300, 450, 600',
          sizes: '(max-width: 600px) 50vw, (max-width: 1024px) 33vw, 25vw',
          alt: product.title | escape,
          class: 'product-card__image-secondary'
        }}
      {%- endif -%}
    </a>

    <div class="product-card__badges">
      {%- if product.tags contains 'Bestseller' -%}
        <span class="badge badge--gold">Bestseller</span>
      {%- elsif product.tags contains 'New' -%}
        <span class="badge badge--hallmark">New Drop</span>
      {%- endif -%}
    </div>

    <button type="button" class="product-card__wishlist" aria-label="Save to Wishlist">
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </button>

    {%- if show_quick_add != false -%}
      <button 
        type="button" 
        class="product-card__quick-add"
        onclick="window.Iraya && window.Iraya.addItem({
          id: {{ product.id | default: 101 }},
          title: '{{ product.title | escape }}',
          price: {{ product.price | divided_by: 100.0 | default: 145.00 }},
          image: '{{ product.featured_image | default: 'cat-earrings.jpg' | asset_url }}'
        })"
      >
        + Quick Add to Bag
      </button>
    {%- endif -%}
  </div>

  <div class="product-card__content">
    <span class="product-card__craft-tag">925 Silver · Handcrafted</span>
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    
    <div class="product-card__rating">
      <span style="color: #C5A880;">★★★★★</span>
      <span>(4.9)</span>
    </div>

    <div class="product-card__price-row">
      <span class="product-card__price">{{ product.price | money }} USD</span>
      <span class="product-card__hallmark">Hallmarked</span>
    </div>
  </div>
</div>
